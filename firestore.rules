rules_version = '2';

// Paste into: Firebase console -> Firestore Database -> Rules -> Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- each user's private journey ---------------------------------
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ---- friends -------------------------------------------------
    // Public card: name, photo, region, team, aggregate record. Any
    // signed-in user can read one; you only write your own.
    match /playerCards/{cardUid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if signedIn() && cardUid == request.auth.uid;
    }
    match /friendCodes/{code} {
      allow get, create: if signedIn();
      allow list: if false;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /friendRequests/{reqId} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    match /friendships/{pairKey} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2;
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a + '_' + b))
          || exists(/databases/$(database)/documents/friendships/$(b + '_' + a));
    }
    function feedIsPublic(ownerUid) {
      return exists(/databases/$(database)/documents/playerCards/$(ownerUid))
        && get(/databases/$(database)/documents/playerCards/$(ownerUid))
             .data.get('feedVisibility', 'private') == 'public';
    }

    // ---- activity feed: each user's recent matches / results ----
    match /activity/{ownerUid}/items/{itemId} {
      allow read: if signedIn() && (
        ownerUid == request.auth.uid
        || (feedIsPublic(ownerUid) && areFriends(ownerUid, request.auth.uid))
      );
      allow create, update, delete: if signedIn() && ownerUid == request.auth.uid;
    }

    // ---- community meta: combo tier list, one vote per user ----
    match /metaCombos/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.blade is string;
      // vote tally updates — the combo's identity and author can't change
      allow update: if signedIn()
        && request.resource.data.blade == resource.data.blade
        && request.resource.data.ratchet == resource.data.ratchet
        && request.resource.data.bit == resource.data.bit
        && request.resource.data.addedBy == resource.data.addedBy;
      allow delete: if false;

      match /votes/{voterUid} {
        allow read: if signedIn();
        allow write: if signedIn() && voterUid == request.auth.uid;
      }
    }

    // ---- invite-code lookup ----------------------------------------
    // Low-value: maps a short code to a teamId so a new member can find
    // the team before they belong to it.
    match /teamCodes/{code} {
      allow read, create, delete: if signedIn();
      allow update: if false;
    }

    // ---- teams (shared between members) ---------------------------
    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    function isMember(teamId) {
      return signedIn() && request.auth.uid in teamData(teamId).memberUids;
    }
    function isOwner(teamId) {
      return signedIn() && teamData(teamId).ownerUid == request.auth.uid;
    }
    function myRole(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.get('role', 'member');
    }
    // owner, or a member the owner promoted to "editor"
    function canManage(teamId) {
      return isOwner(teamId)
        || (isMember(teamId)
            && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
            && myRole(teamId) == 'editor');
    }

    match /teams/{teamId} {
      // any signed-in user may read basic team info (needed to join by code)
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasOnly([request.auth.uid]);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() && (
        // owner can change anything
        resource.data.ownerUid == request.auth.uid

        // an editor can change team info but not ownership or the roster
        || (
          canManage(teamId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids == resource.data.memberUids
        )

        // any member may only add or remove THEMSELVES from the roster
        || (
          request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUids', 'updatedAt'])
          && request.resource.data.memberUids.hasOnly(
               resource.data.memberUids.concat([request.auth.uid]))
          && resource.data.memberUids.hasOnly(
               request.resource.data.memberUids.concat([request.auth.uid]))
        )
      );

      match /members/{memberUid} {
        allow read: if isMember(teamId);

        // joining / editing your own row — but you can't change your own role
        allow create: if signedIn() && memberUid == request.auth.uid
          && request.resource.data.get('role', 'member') in ['member', 'owner'];
        allow update: if signedIn() && (
          teamData(teamId).ownerUid == request.auth.uid
          || (
            memberUid == request.auth.uid
            && request.resource.data.get('role', 'member') == resource.data.get('role', 'member')
          )
        );

        allow delete: if signedIn() && (
          memberUid == request.auth.uid
          || teamData(teamId).ownerUid == request.auth.uid
        );
      }

      match /battles/{battleId} {
        allow read, write: if isMember(teamId);
      }

      match /events/{eventId} {
        allow read, write: if isMember(teamId);
      }
    }
  }
}
